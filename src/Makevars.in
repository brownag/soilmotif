# Makevars for R build of soilmotif with Rust backend
# The configure script builds the Rust library and copies it to src/soilmotif.so
# We compile a minimal C wrapper to trigger R's dyn.load, then link with Rust lib

# C sources: wrapper that defines R_init_soilmotif for R's registration
SOURCES = extendr_registration.c

# Compiled objects
OBJECTS = extendr_registration.o

# Link with the Rust library
# The library is placed in ./soilmotif.so by configure
PKG_LIBS = -L. -lsoilmotif

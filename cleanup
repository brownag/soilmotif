#!/bin/bash

# Cleanup script for soilmotif R package
# Removes build artifacts before R CMD check

# Remove compiled objects and libraries
rm -f src/*.o
rm -f src/*.so
rm -f src/*.a

# Remove generated make files
rm -f src/Makefile
rm -f src/Makevars
rm -f src/Makevars.win

# Remove Rust build artifacts
rm -rf target/

# Remove R data files
rm -f src/*.rds

# Remove package check artifacts
rm -rf ..Rcheck/
rm -f soilmotif*.tar.gz
rm -f soilmotif*.zip

exit 0
